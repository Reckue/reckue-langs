{
  "name": "Reckue Languages",
  "version": "0.10.2",
  "description": "Interactive language learning assistant",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/application.js"
  },
  "action": {
    "default_popup": "dist/popup/index.html",
    "default_icon": {
      "16": "images/coach16.png",
      "32": "images/coach32.png",
      "48": "images/coach48.png",
      "128": "images/coach128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://translate.google.com/*"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "js": [
        "dist/page/page.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/reader/index.html",
        "dist/reader/reader.js",
        "dist/reader/pdf.worker.mjs"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "images/coach16.png",
    "32": "images/coach32.png",
    "48": "images/coach48.png",
    "128": "images/coach128.png"
  },
  "manifest_version": 3
}
